# PEGASUS environment template — variable NAMES only, blank values.
# Copy to .env for local runs. NEVER commit a filled-in .env.
# Production: set these via `fly secrets set` (see README).

# HMAC secret from the Agent Games dashboard ("Rotate Secret"). Required.
AGENT_GAMES_HMAC_SECRET=

# Kurier mainnet API key from https://kurier.xyz. Optional at startup;
# without it, proofs are generated but not submitted to zkVerify.
KURIER_API_KEY=

# Kurier API base. Defaults to mainnet; override for testnet.
# KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1

# Strategy salt for the commitment CLI ONLY (scripts/commitment.js).
# Never log it, never commit it, never share it.
STRATEGY_SALT=

# HTTP port. Defaults to 8080.
PORT=

# Path of the persistent Gatekeeper seen-set file.
# Defaults to data/seen-set.json locally, /data/seen-set.json on Fly.io.
SEEN_SET_PATH=
